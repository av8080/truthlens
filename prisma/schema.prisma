datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Scan {
  id              String          @id @default(uuid())
  scanType        String          // "URL" | "MESSAGE"
  sanitizedInput  String
  verdict         String          // "KNOWN_THREAT" | "HIGH_RISK" | "SUSPICIOUS" | "NO_THREAT_DETECTED" | "INCONCLUSIVE" | "UNABLE_TO_VERIFY"
  heuristicScore  Int?            // 0 to 100
  providerStatus  String          // Summary of third party provider execution status
  createdAt       DateTime        @default(now())
  findings        ScanFinding[]
  providerChecks  ProviderCheck[]

  @@index([createdAt])
  @@index([verdict])
  @@index([scanType])
}

model ScanFinding {
  id          String   @id @default(uuid())
  scanId      String
  scan        Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category    String   // "THREAT_INTEL" | "URL_STRUCTURE" | "DOMAIN_INFO" | "CONTEXTUAL"
  severity    String   // "CRITICAL" | "HIGH" | "MEDIUM" | "LOW" | "INFO"
  title       String
  explanation String
  source      String   // "Google Web Risk" | "VirusTotal" | "Structural Analysis" | "Message Engine"
  metadata    String?  // JSON encoded details if needed
  createdAt   DateTime @default(now())

  @@index([scanId])
}

model ProviderCheck {
  id           String   @id @default(uuid())
  scanId       String
  scan         Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  providerName String   // "Google Web Risk" | "VirusTotal v3"
  status       String   // "MATCH_FOUND" | "NO_MATCH" | "ERROR" | "NOT_CONFIGURED"
  threatTypes  String?  // JSON array string of detected threats
  checkedAt    DateTime @default(now())
  errorCode    String?

  @@index([scanId])
}
