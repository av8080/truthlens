{
  "name": "truthlens",
  "version": "1.0.0",
  "private": true,
  "description": "TruthLens — Think Before You Trust. Advanced Scam Detection & URL Intelligence Platform.",
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build": "npm run build:server && npm run build:client",
    "test": "cd server && npm run test",
    "prisma:push": "npx prisma db push --schema=prisma/schema.prisma",
    "prisma:generate": "npx prisma generate --schema=prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^5.10.0"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0"
  }
}
